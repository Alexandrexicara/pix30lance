# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pix30

# Asaas Payment Gateway
ASAAS_API_KEY=your_asaas_api_key
ASAAS_SANDBOX=false

# Cloudinary (for image uploads)
CLOUDINARY_URL=cloudinary://your_cloudinary_url
# ou
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin WhatsApp (para notificações)
ADMIN_WHATSAPP_PHONE=5511999999999

# MCP - gere uma chave aleatória com pelo menos 32 caracteres
MCP_API_KEY=replace_with_a_random_secret_of_32_chars_or_more

# Server
PORT=3000
